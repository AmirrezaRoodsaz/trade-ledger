# Read-only API keys only. This file is the template; copy it to `.env`,
# which is gitignored and must never be committed.

# --- Trading 212 -------------------------------------------------------------
# App -> Settings -> API (Beta). Generate a key with read scopes only.
# The adapter sends both values as HTTP basic auth; if your key has no separate
# secret, put the key in both fields.
T212_LIVE_API_KEY=
T212_LIVE_API_SECRET=

# Practice (demo) account — a separate key from the same screen.
T212_DEMO_API_KEY=
T212_DEMO_API_SECRET=

# --- OKX ---------------------------------------------------------------------
# Profile -> API -> Create V5 API key, permission "Read" only. The passphrase
# is the one you choose while creating the key.
OKX_LIVE_API_KEY=
OKX_LIVE_API_SECRET=
OKX_LIVE_API_PASSPHRASE=

# OKX demo trading key (created inside demo trading, not the live account).
OKX_DEMO_API_KEY=
OKX_DEMO_API_SECRET=
OKX_DEMO_API_PASSPHRASE=

# --- Kraken ------------------------------------------------------------------
# Settings -> API -> Add key, "Query" permissions only. Kraken has no sandbox.
KRAKEN_LIVE_API_KEY=
KRAKEN_LIVE_API_SECRET=

# --- App ---------------------------------------------------------------------
DB_PATH=data/ledger.db
DATA_DIR=data
NOTES_OUT_DIR=notes_out
HOST=127.0.0.1
PORT=8642
