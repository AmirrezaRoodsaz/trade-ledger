# One bot's environment. Copy to data/bots/<slug>/.env and fill in.
# The file holds a token and API keys: chmod 600, never commit it.
# (data/ is gitignored; the systemd path is /etc/trade-bot/<slug>.env.)

# Where the app answers. Same machine as the app -> localhost. A VPS bot
# needs a reachable URL and TLS in front of it.
TRADE_LEDGER_URL=http://127.0.0.1:8000

# Shown once, when the bot was created (or rotated) in the UI.
BOT_TOKEN=

# ccxt exchange id. "fake" works with --dry-run and needs no keys.
EXCHANGE_ID=okx
EXCHANGE_KEY=
EXCHANGE_SECRET=
EXCHANGE_PASSPHRASE=

# 1 = the venue's demo/sandbox. Set this to 0 only when the money is meant
# to be real and the bot has passed its stage gate.
EXCHANGE_DEMO=1

# spot or swap. Swap orders carry tdMode=isolated and the preset's leverage
# cap; spot has neither.
MARKET_TYPE=spot
