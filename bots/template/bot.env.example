# One bot's environment. `trade-bot new <name>` writes this to
# data/bots/<name>/.env; otherwise copy it there by hand.
# The file holds a token and API keys: chmod 600, never commit it.
# (data/ is gitignored; the systemd path is /etc/trade-bot/<slug>.env.)
#
# Every variable is documented in bots/BOT_CONTRACT.md, section 8.

# Where the app answers. Same machine as the app -> localhost. A bot on a VPS
# needs a reachable URL and TLS in front of it: the token is on every request.
TRADE_LEDGER_URL=http://127.0.0.1:8000

# Shown once, when the bot was created (or rotated) in the UI. Without it
# `trade-bot` refuses to run and exits 1.
BOT_TOKEN=

# ccxt exchange id. "fake" is a flat synthetic market for smoke tests; it
# needs no keys and is refused without --dry-run.
EXCHANGE_ID=okx

# Read + trade, no withdrawal, IP-restricted to the machine the bot runs on.
# EXCHANGE_PASSPHRASE is OKX-style; leave it empty on venues without one.
EXCHANGE_KEY=
EXCHANGE_SECRET=
EXCHANGE_PASSPHRASE=

# 1 = the venue's demo/sandbox. Set this to 0 only when the money is meant
# to be real and the bot has passed its stage gate.
EXCHANGE_DEMO=1

# spot or swap. Swap orders carry tdMode=isolated and the preset's leverage
# cap; spot has neither.
MARKET_TYPE=spot
